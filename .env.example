APP_NAME="Parcia Plugin"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8001

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_ES

APP_MAINTENANCE_DRIVER=file

PHP_CLI_SERVER_WORKERS=4
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ── BASE DE DATOS ─────────────────────────────────────────────────────────────
# Desarrollo local: SQLite (no requiere configuración adicional)
DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=parcia_plugin
# DB_USERNAME=root
# DB_PASSWORD=

# ── SESIÓN / CACHÉ / COLAS ────────────────────────────────────────────────────
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# Desarrollo: database. Producción: redis (requiere Horizon)
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=parcia_plugin

# ── REDIS (para Horizon en producción) ───────────────────────────────────────
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ── GOOGLE OAUTH ─────────────────────────────────────────────────────────────
# Crear en: https://console.cloud.google.com → APIs & Services → Credentials
# URI de redirección autorizada: ${APP_URL}/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"

# ── STRIPE / CASHIER ─────────────────────────────────────────────────────────
# Dashboard: https://dashboard.stripe.com/apikeys
STRIPE_KEY=pk_test_
STRIPE_SECRET=sk_test_
# Webhook: https://dashboard.stripe.com/webhooks → escuchar en ${APP_URL}/stripe/webhook
STRIPE_WEBHOOK_SECRET=whsec_

# Moneda para Cashier (ISO 4217)
CASHIER_CURRENCY=usd
CASHIER_CURRENCY_LOCALE=en

# IDs de precios de Stripe por plan (copiar desde Stripe Dashboard → Products)
PLAN_STARTER_PRICE_ID=price_
PLAN_PRO_PRICE_ID=price_
PLAN_AGENCY_PRICE_ID=price_

# ── CORREO ───────────────────────────────────────────────────────────────────
# Desarrollo: log (los emails van al log, no se envían)
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=smtp.mailgun.org
MAIL_PORT=587
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@parcia.co"
MAIL_FROM_NAME="${APP_NAME}"

# ── TENANT INTERNO PARCIA ─────────────────────────────────────────────────────
# Email del usuario interno que se pre-sembrará en DatabaseSeeder
PARCIA_INTERNAL_EMAIL=andria@parcia.co

# ── INTEGRACIÓN PARCIA CREATORS ──────────────────────────────────────────────
# URL base del CRM parcia-creators
PARCIA_CREATORS_API_URL=https://app.parcia.co
PARCIA_CREATORS_API_KEY=

# ── VITE ─────────────────────────────────────────────────────────────────────
VITE_APP_NAME="${APP_NAME}"
